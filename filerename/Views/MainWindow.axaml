<Window xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
                 xmlns:vm="using:filerename.ViewModels"
                 mc:Ignorable="d"
                 d:DesignWidth="1100" d:DesignHeight="720"
                 x:Class="filerename.Views.MainWindow"
                 x:DataType="vm:MainWindowViewModel"
                 Icon="avares://filerename/Assets/FileRenameLogo.ico"
                 Title="File Rename"
                 Width="1200" Height="800"
                 Background="{DynamicResource SukiStrongBackground}"
                 MinWidth="900" MinHeight="620">
    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Grid Margin="24" ColumnDefinitions="280,*">
        <suki:GlassCard Margin="0,0,20,0">
            <Grid Margin="20" RowDefinitions="*,Auto">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Rename" Classes="section-title" />
                        <TextBlock Classes="secondary" Text="Split filenames with a separator"
                                   TextWrapping="Wrap" />
                        <StackPanel Spacing="8">
                            <TextBlock Text="Separator" Classes="label" />
                            <TextBox Text="{Binding Separator}" PlaceholderText="e.g. _" />
                    </StackPanel>
                    <StackPanel Spacing="8">
                        <TextBlock Text="New Name" Classes="label" />
                        <TextBox Text="{Binding Rule}" PlaceholderText="e.g. New_{0}" />
                    </StackPanel>
                    <TextBlock Classes="secondary" Text="Use {0}, {1}, … for the parts below."
                               TextWrapping="Wrap" />
                    <Separator />
                    <TextBlock Text="Filename parts" Classes="label" />
                    <TextBlock Classes="secondary" Text="Add a file and enter a separator to see its parts."
                               IsVisible="{Binding !SplitPreviewParts.Count}"
                               TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding SplitPreviewParts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:MainWindowViewModel+PreviewPart">
                                <TextBlock Classes="filename-part" Text="{Binding Text}" Margin="0,0,0,8"
                                           TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Row="1" Spacing="12" Margin="0,16,0,0">
                    <Separator />
                    <Button Name="PreviewButton" Classes="Outlined" Content="Preview" Command="{Binding PreviewCommand}"
                            HorizontalAlignment="Stretch" />
                    <Button Classes="Flat main-action" Content="Run rename" Command="{Binding StartCommand}"
                            HorizontalAlignment="Stretch" />
                </StackPanel>
            </Grid>
        </suki:GlassCard>

        <suki:GlassCard Grid.Column="1">
            <Grid Margin="20" RowDefinitions="Auto,Auto,*,Auto">
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                    <TextBlock Text="Files" Classes="section-title" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Classes="secondary" Text="{Binding Files.Count, StringFormat='{}{0} files'}"
                               VerticalAlignment="Center" />
                </Grid>
                <WrapPanel Grid.Row="1" Margin="0,0,0,16">
                    <Button Classes="Outlined" Content="Add files" Command="{Binding AddFilesCommand}"
                            CommandParameter="{Binding $parent[Window].StorageProvider}"
                            Margin="0,0,8,8" />
                    <Button Classes="Outlined" Content="Add folder" Command="{Binding AddFolderCommand}"
                            CommandParameter="{Binding $parent[Window].StorageProvider}"
                            Margin="0,0,8,8" />
                    <Button Classes="Basic" Content="Remove selected" Command="{Binding RemoveSelectedCommand}"
                            Margin="0,0,0,8" />
                </WrapPanel>
                <Grid Grid.Row="2">
                    <StackPanel IsVisible="{Binding !Files.Count}" Spacing="12"
                                HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="320">
                        <Viewbox Width="40" Height="40" HorizontalAlignment="Center">
                            <Path Width="34" Height="36" Stroke="{DynamicResource SukiPrimaryColor}"
                                  StrokeThickness="1.5" StrokeJoin="Round"
                                  Data="M 6,2 L 20,2 L 28,10 L 28,34 L 6,34 Z M 20,2 L 20,10 L 28,10 M 11,17 L 23,17 M 11,23 L 23,23 M 11,29 L 19,29" />
                        </Viewbox>
                        <TextBlock Text="Ready for a fresh name" Classes="label" HorizontalAlignment="Center" />
                        <TextBlock Text="Add files or a folder to start. Preview the new names before running the rename."
                                   Classes="secondary" TextWrapping="Wrap" TextAlignment="Center" />
                    </StackPanel>
                    <DataGrid Name="FileGrid" IsVisible="{Binding !!Files.Count}"
                              ItemsSource="{Binding Files}"
                              AutoGenerateColumns="False"
                              CanUserResizeColumns="True"
                              CanUserReorderColumns="True"
                              CanUserSortColumns="True">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Select" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:FileItemViewModel">
                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Original name" Binding="{Binding OriginalName}"
                                                Width="*" IsReadOnly="True" />
                            <DataGridTextColumn Header="New name" Binding="{Binding NewName}"
                                                Width="*" IsReadOnly="True" />
                            <DataGridTemplateColumn Header="Status" Width="100" SortMemberPath="Status" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:FileItemViewModel">
                                        <Border Classes="status" Classes.ready="{Binding IsReady}"
                                                Classes.success="{Binding IsSuccess}" Classes.error="{Binding IsError}"
                                                IsVisible="{Binding HasStatus}">
                                            <TextBlock Text="{Binding Status}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
                <Grid Grid.Row="3" ColumnDefinitions="Auto,*" Margin="0,16,0,0">
                    <Button Classes="Basic" Content="Select / deselect all" Command="{Binding SelectAllCommand}" />
                    <TextBlock Grid.Column="1" Classes="secondary" Text="Only checked files will be renamed."
                               Margin="16,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                </Grid>
            </Grid>
        </suki:GlassCard>
    </Grid>
</Window>
