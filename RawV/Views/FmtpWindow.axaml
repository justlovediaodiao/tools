<Window x:Class="RawV.Views.FmtpWindow"
                 x:DataType="vm:FmtpWindowViewModel"
                 xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:vm="using:RawV.ViewModels"
                 xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
                 Width="1000" Height="760" MinWidth="880" MinHeight="680"
                 Background="{DynamicResource SukiStrongBackground}"
                 Icon="avares://RawV/Assets/RawVLogo.ico" Title="MTP sync">
    <Grid Margin="24" RowDefinitions="Auto,*,Auto">
        <StackPanel Spacing="6" Margin="0,0,0,20">
            <TextBlock Text="Bring your photos home" Classes="title" />
            <TextBlock Text="Synchronize your device with a local photo folder." Classes="secondary" />
        </StackPanel>
        <Grid Grid.Row="1" ColumnDefinitions="320,*">
            <suki:GlassCard Margin="0,0,20,0">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="20" Spacing="18">
                        <TextBlock Text="Sync locations" Classes="heading" />
                        <StackPanel Spacing="8">
                            <TextBlock Text="Local folder" Classes="label" />
                            <TextBox Name="LocalDirectoryInput" Text="{Binding LocalDirectory, Mode=TwoWay}"
                                     IsEnabled="{Binding !IsRunning}" PlaceholderText="Folder on this computer" />
                            <Button Content="Choose folder" Classes="Outlined" Click="OnBrowseLocalDirectoryClick"
                                    IsEnabled="{Binding !IsRunning}" HorizontalAlignment="Left" />
                        </StackPanel>
                        <StackPanel Spacing="8">
                            <TextBlock Text="Device folder" Classes="label" />
                            <TextBox Name="MtpPathInput" Text="{Binding MtpPath, Mode=TwoWay}"
                                     IsEnabled="{Binding !IsRunning}" PlaceholderText="MTP path from Windows Explorer" />
                            <TextBlock Text="Copy the device folder path from Windows Explorer and paste it here."
                                       Classes="secondary" TextWrapping="Wrap" />
                        </StackPanel>
                        <Separator />
                        <TextBlock Text="What will change" Classes="label" />
                        <TextBlock Text="New device files are copied into the local folder. Local-only files are moved into its diff folder."
                                   Classes="secondary" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </suki:GlassCard>
            <suki:GlassCard Grid.Column="1">
                <Grid Margin="20" RowDefinitions="Auto,Auto,*">
                    <StackPanel Spacing="10" Margin="0,0,0,20">
                        <TextBlock Text="Sync progress" Classes="heading" />
                        <TextBlock Name="SyncStatusLabel" Text="{Binding StatusMessage}" Classes="secondary" TextWrapping="Wrap" />
                        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsRunning}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Spacing="20" Margin="0,0,0,20">
                        <StackPanel Spacing="8" IsVisible="{Binding HasMoveProgress}">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Move local-only files" Classes="label" />
                                <TextBlock Grid.Column="1" Classes="secondary">
                                    <Run Text="{Binding MoveCurrent}" /><Run Text=" / " /><Run Text="{Binding MoveTotal}" />
                                </TextBlock>
                            </Grid>
                            <ProgressBar Name="MoveProgress" Maximum="{Binding MoveMaximum}" Value="{Binding MoveCurrent}" />
                            <TextBlock Text="{Binding MoveFile}" Classes="secondary" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Spacing="8" IsVisible="{Binding HasCopyProgress}">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Copy device photos" Classes="label" />
                                <TextBlock Grid.Column="1" Classes="secondary">
                                    <Run Text="{Binding CopyCurrent}" /><Run Text=" / " /><Run Text="{Binding CopyTotal}" />
                                </TextBlock>
                            </Grid>
                            <ProgressBar Name="CopyProgress" Maximum="{Binding CopyMaximum}" Value="{Binding CopyCurrent}" />
                            <TextBlock Text="{Binding CopyFile}" Classes="secondary" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>
                    <Expander Grid.Row="2" Header="Activity" IsExpanded="{Binding IsActivityExpanded, Mode=TwoWay}"
                              HorizontalAlignment="Stretch" VerticalAlignment="Top">
                        <Border Background="{DynamicResource InsetBrush}" CornerRadius="10" Padding="8" Margin="0,8,0,0">
                            <ListBox Name="LogListBox" ItemsSource="{Binding LogEntries}" MaxHeight="240"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{Binding}" Classes="mono" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Expander>
                </Grid>
            </suki:GlassCard>
        </Grid>
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,20,0,0">
            <TextBlock Text="Review the locations before starting." Classes="secondary" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                <Button Name="CancelSyncButton" Content="Cancel sync" Classes="Outlined" Command="{Binding CancelCommand}"
                        IsVisible="{Binding IsRunning}" />
                <Button Name="CloseSyncButton" Content="Close" Classes="Basic" Click="OnCloseClick" IsEnabled="{Binding !IsRunning}" />
                <Button Name="StartSyncButton" Content="Start sync" Classes="Flat main-action" Command="{Binding RunCommand}" IsEnabled="{Binding CanRun}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
