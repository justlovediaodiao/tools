<Window x:Class="RawV.Views.DeleteConfirmationWindow"
                 xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
                 Width="540" Height="400" CanResize="False" WindowStartupLocation="CenterOwner"
                 Background="{DynamicResource SukiStrongBackground}"
                 Icon="avares://RawV/Assets/RawVLogo.ico" Title="Move photo to bin">
    <suki:GlassCard Margin="20">
        <Grid Margin="24" RowDefinitions="Auto,*,Auto">
            <TextBlock Text="Let this shot go?" Classes="title" />
            <StackPanel Grid.Row="1" Spacing="14" VerticalAlignment="Center" Margin="0,16">
                <TextBlock Text="The current photo and its matching RAW files will be moved to the Recycle Bin."
                           Classes="secondary" TextWrapping="Wrap" />
                <Border Background="{DynamicResource InsetBrush}" CornerRadius="10" Padding="14">
                    <TextBlock Text="You can restore them from the Recycle Bin if you change your mind."
                               Classes="secondary" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                <Button Name="CancelDeleteButton" Content="Keep photo" Classes="Outlined" Click="OnCancelClick" />
                <Button Name="ConfirmDeleteButton" Content="Move to bin" Classes="Basic danger" Click="OnConfirmClick" />
            </StackPanel>
        </Grid>
    </suki:GlassCard>
</Window>
