<suki:SukiWindow x:Class="RawV.Views.MainWindow"
                 x:DataType="vm:MainWindowViewModel"
                 xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:vm="using:RawV.ViewModels"
                 xmlns:automation="using:Avalonia.Automation"
                 xmlns:services="using:RawV.Services"
                 xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
                 Width="1400" Height="900" MinWidth="800" MinHeight="500"
                 BackgroundStyle="Flat" BackgroundAnimationEnabled="False"
                 Icon="avares://RawV/Assets/RawVLogo.ico" Title="RawV">
    <Grid RowDefinitions="Auto,*,Auto">
        <Border Name="CommandBar" Background="{DynamicResource SukiCardBackground}"
                BorderBrush="{DynamicResource SukiBorderBrush}" BorderThickness="0,0,0,1" Padding="10,3">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <ToggleButton Name="SidebarToggle" Classes="Basic compact icon-action workspace-toggle"
                                  IsChecked="{Binding IsSidebarVisible, Mode=TwoWay}" IsEnabled="{Binding CurrentSession.HasItems}"
                                  ToolTip.Tip="Show or hide thumbnails" automation:AutomationProperties.Name="Toggle photo thumbnails"
                                  Focusable="False">
                        <PathIcon Width="16" Height="16" Foreground="{Binding $parent[ToggleButton].Foreground}"
                                  Data="F0 M3,4H21V20H3Z M5,6H8V18H5Z M10,6H19V18H10Z" />
                    </ToggleButton>
                    <Button Name="OpenFilesButton" Content="Open files" Classes="Small Outlined compact"
                            Click="OnOpenFilesClick" IsVisible="{Binding CurrentSession.HasItems}" Focusable="False" />
                    <Button Name="OpenFolderButton" Content="Open folder" Classes="Small Outlined compact" Click="OnOpenFolderClick"
                            IsVisible="{Binding CurrentSession.HasItems}" Focusable="False" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Name="MtpSyncButton" Content="MTP sync" Classes="Small Basic compact" Click="OnFmtpClick"
                            IsVisible="{x:Static services:FmtpService.IsExecutableAvailable}" Focusable="False" />
                    <TextBlock Text="Confirm delete" Classes="secondary" FontSize="12" VerticalAlignment="Center" />
                    <ToggleSwitch Name="ConfirmDeleteToggle" IsChecked="{Binding DeleteConfirmationEnabled, Mode=TwoWay}"
                                  ToolTip.Tip="Confirm before moving the photo and matching RAW files to the Recycle Bin"
                                  Focusable="False" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*">
            <Border Name="PhotoSidebar" Width="168" IsVisible="{Binding IsSidebarVisible}"
                    Background="{DynamicResource InsetBrush}" BorderBrush="{DynamicResource SukiBorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,*">
                    <Grid ColumnDefinitions="*,Auto" Margin="10,6">
                        <TextBlock Text="Photos" FontSize="12" Classes="label" />
                        <TextBlock Grid.Column="1" Text="{Binding Thumbnails.Count}" Classes="secondary" FontSize="12" />
                    </Grid>
                    <ListBox Grid.Row="1" Name="ThumbnailListBox" Classes="photo-list Void"
                             ItemsSource="{Binding Thumbnails}" SelectedItem="{Binding SelectedThumbnail, Mode=TwoWay}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" Padding="4">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel Orientation="Vertical" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ThumbnailItemViewModel">
                                <StackPanel Spacing="4" ToolTip.Tip="{Binding FileName}">
                                    <Border Classes="thumbnail-frame" Classes.selected="{Binding IsSelected}"
                                            Height="92" Padding="2" ClipToBounds="True">
                                        <Panel>
                                            <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                                            <TextBlock Text="Photo" Classes="secondary" IsVisible="{Binding !IsLoaded}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Panel>
                                    </Border>
                                    <TextBlock Text="{Binding FileName}" FontSize="11" Foreground="{DynamicResource SukiLowText}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
            <Border Name="PhotoCanvas" Grid.Column="1" Background="{DynamicResource PhotoCanvasBrush}" ClipToBounds="True">
                <Panel>
                    <Image Name="PhotoPreview" Source="{Binding CurrentBitmap}" Stretch="Uniform"
                           IsVisible="{Binding HasImage}" Margin="4" />
                    <StackPanel Name="EmptyState" IsVisible="{Binding IsEmptyState}" MaxWidth="400" Margin="24"
                                HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                        <Border Width="64" Height="64" CornerRadius="14" ClipToBounds="True" HorizontalAlignment="Center">
                            <Image Source="avares://RawV/Assets/RawVLogo.png" />
                        </Border>
                        <TextBlock Text="Make room for your best shots" Classes="title" TextWrapping="Wrap" TextAlignment="Center" />
                        <TextBlock Text="Open a folder or a selection of images. Browse the previews, then move unwanted shots and their matching RAW files to the Recycle Bin."
                                   Classes="secondary" TextWrapping="Wrap" TextAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                            <Button Name="EmptyOpenFilesButton" Content="Open files" Classes="Flat main-action"
                                    Click="OnOpenFilesClick" Focusable="False" />
                            <Button Name="EmptyOpenFolderButton" Content="Open folder" Classes="Outlined"
                                    Click="OnOpenFolderClick" Focusable="False" />
                        </StackPanel>
                        <TextBlock Text="← / → Browse    ·    Delete: move to bin" Classes="secondary" TextAlignment="Center" />
                    </StackPanel>
                    <Border IsVisible="{Binding IsBusy}" Background="{DynamicResource PhotoCanvasBrush}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                            <ProgressBar Width="180" IsIndeterminate="True" />
                            <TextBlock Text="Loading photo…" Classes="secondary" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Panel Name="ErrorState" IsVisible="{Binding HasError}">
                        <Border Background="{DynamicResource ScrimBrush}" />
                        <suki:GlassCard MaxWidth="460" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center" IsOpaque="True">
                            <StackPanel Margin="24" Spacing="12">
                                <TextBlock Text="This photo needs attention" Classes="heading" />
                                <TextBlock Text="{Binding ErrorMessage}" Classes="secondary" TextWrapping="Wrap" />
                                <TextBlock Text="You can still browse other photos using the navigation below."
                                           Classes="secondary" TextWrapping="Wrap" />
                            </StackPanel>
                        </suki:GlassCard>
                    </Panel>
                </Panel>
            </Border>
        </Grid>
        <Border Name="StatusBar" Grid.Row="2" Background="{DynamicResource SukiCardBackground}"
                BorderBrush="{DynamicResource SukiBorderBrush}" BorderThickness="0,1,0,0" Padding="10,4">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Name="CurrentFileLabel" Text="{Binding CurrentFileName}" FontSize="12"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,16,0"
                           ToolTip.Tip="{Binding CurrentItem.FilePath}" />
                <TextBlock Grid.Column="1" Text="{Binding CurrentStatus}" FontSize="12" Foreground="{DynamicResource SukiLowText}"
                           VerticalAlignment="Center" Margin="0,0,16,0" MaxWidth="280" TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                    <Button Name="PreviousButton" Content="←" Classes="Small Outlined compact" Command="{Binding PreviousCommand}"
                            ToolTip.Tip="Previous photo (Left / Up)" Focusable="False" />
                    <Button Name="NextButton" Content="→" Classes="Small Outlined compact" Command="{Binding NextCommand}"
                            ToolTip.Tip="Next photo (Right / Down)" Focusable="False" />
                    <Button Name="DeleteButton" Classes="Basic compact icon-action danger" Click="OnDeleteClick"
                            IsEnabled="{Binding CanDelete}" ToolTip.Tip="Move the photo and matching RAW files to the Recycle Bin (Delete)"
                            automation:AutomationProperties.Name="Move photo to bin" Focusable="False">
                        <PathIcon Width="16" Height="16" Foreground="{Binding $parent[Button].Foreground}"
                                  Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</suki:SukiWindow>
